# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.*
!.env.example

# Pytest / coverage caches
.pytest_cache/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Playwright artifacts
test-results/
playwright-report/
playwright/.cache/
blob-report/

# Generated test reports
reports/*
!reports/.gitkeep

# Excel lock files (created while the workbook is open)
~$*.xlsx

# IDEs and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
